// Artery AT32F415RCT7 (Cortex-M4, 256 KB flash, 32 KB SRAM) for Renode.
//
// Adapted from Renode's platforms/cpus/stm32f103.repl: the AT32F415 follows
// the STM32F1 register layout for GPIO, USART, SPI, I2C, timers and DMA.
// Interrupt numbers come from the AT32F415 SVD. Peripherals without a model
// (FLASH, ADC...) are logged by name thanks to ApplySVD in mpk.resc.

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x40000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    // 8 MHz internal oscillator (HICK) at reset; updated by crm.
    systickFrequency: 8000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

// ---------------------------------------------------------------- GPIO

gpioPortA: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010800, +0x400>

gpioPortB: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010C00, +0x400>

gpioPortC: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011000, +0x400>

gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>

gpioPortF: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011C00, +0x400>

// The AT32F415 has no ports E and G, but Renode's AFIO model expects seven
// ports. They sit at the STM32F1 addresses and are never used.
gpioPortE: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011800, +0x400>

gpioPortG: GPIOPort.STM32F1GPIOPort @ sysbus <0x40012000, +0x400>

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 19
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

// IOMUX is the AT32 name of the STM32F1 AFIO.
iomux: GPIOPort.STM32F1AFIO @ sysbus 0x40010000
    gpioPorts: [gpioPortA, gpioPortB, gpioPortC, gpioPortD, gpioPortE, gpioPortF, gpioPortG]
    [0-15] -> exti@[0-15]

// ---------------------------------------------------------------- DMA

// Same per-channel register layout as the STM32F1 DMA.
dma1: DMA.STM32G0DMA @ sysbus 0x40020000
    numberOfChannels: 7
    [0-6] -> nvic@[11-17]

dma2: DMA.STM32G0DMA @ sysbus 0x40020400
    numberOfChannels: 7
    [0-2] -> nvic@[56-58]
    [3-4] -> dma2Input59@[0-1]
    [5-6] -> dma2Input75@[0-1]

// DMA2 channels 4-5 and 6-7 share one interrupt each.
dma2Input59: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@59

dma2Input75: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@75

// ---------------------------------------------------------------- Serial

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    -> nvic@37

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39

uart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52

uart5: UART.STM32_UART @ sysbus <0x40005000, +0x100>
    -> nvic@53

// Default STM32F1 DMA request mapping: SPI1_TX -> DMA1 ch3, SPI2_TX -> DMA1 ch5.
spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F1
    IRQ -> nvic@35
    DMASend -> dma1@3

spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: STM32Series.F1
    IRQ -> nvic@36
    DMASend -> dma1@5

i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

// ---------------------------------------------------------------- Timers

timer1: Timers.STM32_Timer @ sysbus 0x40012C00
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25
    TriggerInterrupt -> nvic@26
    CommutationInterrupt -> nvic@26
    CaptureCompareInterrupt -> nvic@27
    frequency: 8000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    IRQ -> nvic@28
    frequency: 8000000
    initialLimit: 0xFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    IRQ -> nvic@29
    frequency: 8000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    IRQ -> nvic@30
    frequency: 8000000
    initialLimit: 0xFFFF

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    IRQ -> nvic@50
    frequency: 8000000
    initialLimit: 0xFFFF

// ---------------------------------------------------------------- System

// Clock and reset manager: hackai-mpk model (sim/peripherals/AT32_CRM.cs).
// It sets the SysTick frequency from the clock configuration.
crm: Miscellaneous.AT32_CRM @ sysbus 0x40021000
    nvic: nvic

// USB OTG FS: stub that lets the USB initialisation finish with no host
// connected (sim/peripherals/AT32_OTGFS.cs). IRQ 67, see docs/firmware-image.md.
otgfs: USB.AT32_OTGFS @ sysbus 0x50000000
