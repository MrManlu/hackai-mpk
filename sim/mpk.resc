:name: AKAI MPK Mini Plus
:description: Runs the stock firmware (baserom/firmware.bin) on a simulated MPK Mini Plus.

$repo ?= $ORIGIN/..
$firmware ?= $repo/baserom/firmware.bin

include $ORIGIN/peripherals/AT32_CRM.cs
include $ORIGIN/peripherals/AT32_ADC.cs
include $ORIGIN/peripherals/AT32_FLASH.cs
include $ORIGIN/peripherals/AT32_OTGFS.cs
include $ORIGIN/peripherals/SSD1306.cs
include $ORIGIN/peripherals/SpiRecorder.cs
include $ORIGIN/peripherals/ShiftRegisterLeds.cs
include $ORIGIN/peripherals/KeyMatrix.cs
include $ORIGIN/peripherals/RotaryEncoder.cs
include $ORIGIN/peripherals/MidiMonitor.cs

mach create "mpk"
machine LoadPlatformDescription $ORIGIN/mpk_mini_plus.repl

# Name unmodelled registers in the log (FLASH, ADC...).
sysbus ApplySVD $repo/build/svd/AT32F415xx_v2.renode.svd

# Device information: flash size 256 KB (F_SIZE at 0x1FFFF7E0).
sysbus WriteWord 0x1FFFF7E0 0x0100

# Analog controls at rest (centre of their calibration range): pitch wheel,
# joystick X and Y. See sim/gui/mpk_mini_plus.toml.
adc1 SetInput 2 1 1597
adc1 SetInput 2 2 1846
adc1 SetInput 2 3 1846

# The firmware is loaded once: flash then keeps whatever the firmware (or an
# update) writes to it across `machine Reset`, like the real device.
sysbus LoadBinary $firmware 0x08000000

macro reset
"""
    cpu VectorTableOffset 0x08000000
    # GPIO ports forget the key matrix column levels on reset: drive them
    # again, or the bootloader sees two keys held (update mode).
    keys Reset
    encoder Reset
"""
runMacro $reset
