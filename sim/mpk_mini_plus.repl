// AKAI MPK Mini Plus main board for Renode: the AT32F415 plus what is wired
// to it. See docs/hardware.md and docs/display.md for the evidence.

using "at32f415.repl"

// SSD1306 OLED on SPI2. D/C on PB14 (low = command), CS on PB12 and RESET
// on PB10 are not modelled yet.
oled: Video.SSD1306 @ spi2
    width: 128
    height: 32
    scale: 4

// LEDs: chain of 7 shift registers (56 outputs, active low) on SPI1, TX by
// DMA1 channel 3. PB4 latches (rising edge), PB9 is probably /OE (kept low).
// The firmware does 32-level software PWM at 5 kHz. See docs/leds.md.
leds: Miscellaneous.ShiftRegisterLeds @ spi1
    bytes: 7
    activeLow: true

gpioPortB:
    4 -> leds@0
    14 -> oled@0

// Button matrix: rows PC0-PC3 (outputs, active low), columns PC8-PC13
// (inputs, active low with pull-ups). Which button sits where is still being
// mapped (see docs/simulator.md). `keys Press 0 1`, `keys Release 0 1`.
// Simulator-only: placed at an unused address so the monitor can reach it.
keys: Miscellaneous.KeyMatrix @ sysbus 0xA0000000
    rows: 4
    columns: 6
    [0-5] -> gpioPortC@[8-13]

gpioPortC:
    [0-3] -> keys@[0-3]
