// AKAI MPK Mini Plus main board for Renode: the AT32F415 plus what is wired
// to it. See docs/hardware.md and docs/display.md for the evidence.

using "at32f415.repl"

// SSD1306 OLED on SPI2. D/C on PB14 (low = command), CS on PB12 (active
// low). Another device shares SPI2 with its own CS (see docs/display.md).
// RESET on PB10 is not modelled.
oled: Video.SSD1306 @ spi2
    width: 128
    height: 32
    scale: 4

// LEDs: chain of 7 shift registers (56 outputs, active low) on SPI1, TX by
// DMA1 channel 3. PB4 latches (rising edge), PB9 is probably /OE (kept low).
// The firmware does 32-level software PWM at 5 kHz. See docs/leds.md.
leds: Miscellaneous.ShiftRegisterLeds @ spi1
    bytes: 7
    activeLow: true

// Analog inputs: 8:1 multiplexers in front of ADC channels 0-4 (PA0-PA4),
// select lines PB0-PB2. Pads, knobs, wheels and joystick (mapping to find).
gpioPortB:
    [0-2] -> adc1@[0-2]
    4 -> leds@0
    12 -> oled@1
    14 -> oled@0

// Key matrix: the firmware puts a row number (0-12) on PC0-PC3, a decoder
// selects that row, and PC8-PC15 read the 8 columns (active low).
// 13 x 8 = 104 positions: the 18 buttons (rows 10-12) and probably the
// keybed (two contacts per key for velocity). See docs/simulator.md.
// Simulator-only: placed at an unused address so the monitor can reach it.
keys: Miscellaneous.KeyMatrix @ sysbus 0xA0000000
    addressBits: 4
    columns: 8
    [0-7] -> gpioPortC@[8-15]

// Encoder (PUSH TO ENTER): quadrature on PC4 (A) and PC5 (B), polled by
// FUN_0801df48. `encoder Turn 1` / `encoder Turn -1`.
encoder: Miscellaneous.RotaryEncoder @ sysbus 0xA0000010
    0 -> gpioPortC@4
    1 -> gpioPortC@5

gpioPortC:
    [0-3] -> keys@[0-3]

// MIDI OUT (5-pin DIN) on USART1, sent by DMA. Simulator-only monitor that
// decodes what the firmware transmits: `midiOut Messages 20`.
midiOut: Miscellaneous.MidiMonitor @ sysbus 0xA0000020
    uart: usart1
